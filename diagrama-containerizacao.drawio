        <mxCell id="runtimeLabel" value="02  EXECUÇÃO E FLUXO DA REQUISIÇÃO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=none;fontColor=#166534;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="680" width="430" height="38" as="geometry"/></mxCell>
        <mxCell id="client" value="&lt;div style=&quot;font-size:18px;font-weight:700&quot;&gt;Cliente externo&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:10px&quot;&gt;Navegador ou outro serviço&lt;br&gt;envia uma chamada HTTP&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="230" height="125" as="geometry"/></mxCell>
        <mxCell id="host" value="&lt;div style=&quot;font-size:18px;font-weight:700&quot;&gt;Máquina host&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:10px&quot;&gt;&lt;code&gt;http://localhost:8000&lt;/code&gt;&lt;br&gt;porta publicada pelo Docker&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="360" y="770" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="containerBoundary" value="CONTAINER EM EXECUÇÃO  •  serviço &lt;code&gt;api&lt;/code&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=2;dashed=1;fontColor=#166534;fontStyle=1;fontSize=14;align=left;verticalAlign=top;spacingTop=12;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="760" y="735" width="800" height="195" as="geometry"/></mxCell>
        <mxCell id="containerPort" value="&lt;div style=&quot;font-size:17px;font-weight:700&quot;&gt;Porta do container&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:12px&quot;&gt;&lt;code&gt;:8000&lt;/code&gt;&lt;br&gt;recebe a porta publicada&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="795" y="790" width="225" height="105" as="geometry"/></mxCell>
        <mxCell id="appProcess" value="&lt;div style=&quot;font-size:17px;font-weight:700&quot;&gt;Uvicorn → FastAPI&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:10px&quot;&gt;&lt;code&gt;0.0.0.0:8000&lt;/code&gt; aceita conexões&lt;br&gt;&lt;code&gt;main:app&lt;/code&gt; encaminha à rota&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="1090" y="790" width="430" height="105" as="geometry"/></mxCell>

        <mxCell id="imageToContainer" value="imagem usada para criar o container" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F97316;strokeWidth=2;endArrow=block;endFill=1;fontColor=#9A3412;fontSize=12;exitX=1;exitY=0.84;entryX=0.14;entryY=0;" edge="1" parent="1" source="image" target="containerBoundary"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="720" y="615"/><mxPoint x="870" y="615"/></Array></mxGeometry></mxCell>
        <mxCell id="composeUp" value="docker compose up" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;fontColor=#92400E;fontSize=12;exitX=0.64;exitY=1;entryX=0.68;entryY=0;" edge="1" parent="1" source="compose" target="containerBoundary"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="volumeMount" value="volume de desenvolvimento: .:/app  •  código local sincronizado; Uvicorn usa --reload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontColor=#9A3412;fontSize=12;exitX=1;exitY=0.9;entryX=0.85;entryY=0;" edge="1" parent="1" source="source" target="appProcess"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="410"/><mxPoint x="325" y="655"/><mxPoint x="1455" y="655"/></Array></mxGeometry></mxCell>

