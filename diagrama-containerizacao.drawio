  <diagram id="fastapi-docker-flow" name="FastAPI no Docker">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;div style=&quot;font-size:30px;font-weight:700&quot;&gt;FastAPI no Docker: do código à requisição&lt;/div&gt;&lt;div style=&quot;font-size:15px;margin-top:8px;opacity:.9&quot;&gt;Build reproduzível, inicialização com Compose e caminho de uma chamada HTTP&lt;/div&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=28;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="1540" height="100" as="geometry"/></mxCell>
        <mxCell id="buildLabel" value="01  BUILD E ORQUESTRAÇÃO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=none;fontColor=#334155;fontStyle=1;fontSize=14;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="330" height="38" as="geometry"/></mxCell>

        <mxCell id="source" value="&lt;div style=&quot;font-size:19px;font-weight:700&quot;&gt;Código-fonte&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:12px&quot;&gt;&lt;code&gt;main.py&lt;/code&gt; — rotas FastAPI&lt;br&gt;&lt;code&gt;pyproject.toml&lt;/code&gt; — dependências&lt;br&gt;&lt;code&gt;poetry.lock&lt;/code&gt; — versões fixadas&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="220" width="255" height="185" as="geometry"/></mxCell>
        <mxCell id="dockerfile" value="&lt;div style=&quot;font-size:19px;font-weight:700&quot;&gt;Dockerfile&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:12px&quot;&gt;Receita de build&lt;br&gt;• Python 3.12&lt;br&gt;• instala Poetry e dependências&lt;br&gt;• copia &lt;code&gt;main.py&lt;/code&gt;&lt;br&gt;• define o comando Uvicorn&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="50" y="445" width="255" height="190" as="geometry"/></mxCell>
        <mxCell id="image" value="&lt;div style=&quot;font-size:19px;font-weight:700&quot;&gt;Imagem Docker&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:12px&quot;&gt;Resultado do build&lt;br&gt;&lt;code&gt;fastapi-poetry-api:local&lt;/code&gt;&lt;br&gt;&lt;br&gt;Sistema Python + dependências instaladas + código da aplicação + comando padrão&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=2;fontColor=#9A3412;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="420" y="320" width="285" height="225" as="geometry"/></mxCell>
        <mxCell id="compose" value="&lt;div style=&quot;font-size:19px;font-weight:700&quot;&gt;docker-compose.yml&lt;/div&gt;&lt;div style=&quot;font-size:14px;margin-top:12px&quot;&gt;&lt;b&gt;build: .&lt;/b&gt; usa o Dockerfile&lt;br&gt;&lt;b&gt;ports: 8000:8000&lt;/b&gt;&lt;br&gt;&lt;b&gt;volumes: .:/app&lt;/b&gt;&lt;br&gt;&lt;b&gt;APP_ENV=development&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;docker compose up&lt;/code&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontColor=#78350F;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="820" y="215" width="285" height="225" as="geometry"/></mxCell>

